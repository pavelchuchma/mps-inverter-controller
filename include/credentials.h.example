// Template for include/credentials.h
// Copy this file to credentials.h and fill in your real values:
//   cp include/credentials.h.example include/credentials.h
// credentials.h is git-ignored and must never be committed.

#define WIFI_SSID "<your-wifi-ssid>"
#define WIFI_PASSWORD "<your-wifi-password>"

#define AP_SSID "<your-ap-ssid>"
#define AP_PASS "<your-ap-password>"

// WireGuard VPN
#define WG_PRIVATE_KEY    "<your-wg-private-key>"
#define WG_LOCAL_IP       "<your-wg-local-ip>"
#define WG_PEER_PUBLIC_KEY "<your-wg-peer-public-key>"
#define WG_ENDPOINT       "<your-wg-endpoint>"
#define WG_ENDPOINT_PORT  51820

// InfluxDB 2.x metrics sink (RPi over WireGuard)
#define INFLUX_HOST   "<your-influx-host>"
#define INFLUX_PORT   8086
#define INFLUX_ORG    "<your-influx-org>"
#define INFLUX_BUCKET "<your-influx-bucket>"
// Write-only token for the bucket — create in InfluxDB UI (Load Data ->
// API Tokens -> Custom API Token, Write on the bucket, name e.g. "esp32-fv").
#define INFLUX_TOKEN  "<your-influx-write-token>"
